# ==============================================================================
# FoodWaste Predictor by Paionios — Environment Variables Template
# ------------------------------------------------------------------------------
# Salin file ini menjadi ".env" lalu isi nilai-nilai di bawah sesuai kebutuhan:
#     cp .env.example .env
#
# JANGAN PERNAH commit file ".env" (berisi rahasia) ke repositori Git.
# File ".env" sudah dimasukkan ke .gitignore secara default.
# ==============================================================================

# --- WAJIB DIISI ---------------------------------------------------------------
# API Key Google Gemini. Dapatkan secara gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# --- OPSIONAL (sudah memiliki nilai default yang aman) --------------------------
# Model Gemini Flash yang digunakan oleh ai_engine.py
GEMINI_MODEL=gemini-3.7-flash

# Tingkat kreativitas model (0.0 = paling deterministik, 1.0 = paling variatif)
GEMINI_TEMPERATURE=0.4

# Jumlah percobaan ulang (retry) apabila panggilan/parsing JSON pertama gagal
GEMINI_MAX_RETRIES=2

# Batas waktu (detik) untuk satu kali panggilan ke Gemini API
GEMINI_TIMEOUT_SECONDS=30

# Identitas aplikasi yang ditampilkan pada header UI
APP_TITLE=FoodWaste Predictor by Paionios
APP_SUBTITLE=AI Demand & Food Waste Predictor untuk Bakery, Restoran, dan Supermarket
TEAM_NAME=Paionios

# Konfigurasi server Gradio
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# Set "true" untuk menampilkan traceback error di log container (debugging)
APP_DEBUG=false
